{
  "name": "why-converter",
  "version": "1.0.0",
  "description": "Why would you ever use this? A universal library for converting videos to PDF, GIF, or image sequences with advanced frame extraction options",
  "main": "./dist/node/index.node.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/node/index.node.d.ts",
  "exports": {
    ".": {
      "node": {
        "import": {
          "types": "./dist/node/index.node.d.mts",
          "default": "./dist/node/index.node.mjs"
        },
        "require": {
          "types": "./dist/node/index.node.d.ts",
          "default": "./dist/node/index.node.js"
        }
      },
      "browser": {
        "types": "./dist/node/index.node.d.ts",
        "default": "./dist/browser/index.js"
      },
      "import": {
        "types": "./dist/node/index.node.d.mts",
        "default": "./dist/node/index.node.mjs"
      },
      "default": {
        "types": "./dist/node/index.node.d.ts",
        "default": "./dist/node/index.node.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:node && npm run build:esm && npm run build:browser",
    "build:node": "tsc -p tsconfig.node.json",
    "build:esm": "node scripts/write-esm-entry.js",
    "build:browser": "webpack --config webpack.config.js",
    "dev": "tsc -p tsconfig.node.json --watch",
    "test": "jest",
    "test:browser": "npm run build:browser && jest -c jest.browser.config.js",
    "test:package": "npm run build && node test/package/smoke.mjs && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "video",
    "pdf",
    "gif",
    "frames",
    "converter",
    "ffmpeg",
    "video-processing",
    "image-extraction",
    "why",
    "meme"
  ],
  "author": "Rhys E",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/REllwood/why-converter.git"
  },
  "bugs": {
    "url": "https://github.com/REllwood/why-converter/issues"
  },
  "homepage": "https://github.com/REllwood/why-converter#readme",
  "license": "MIT",
  "dependencies": {
    "fluent-ffmpeg": "^2.1.2",
    "gifenc": "^1.0.3",
    "jspdf": "^2.5.1",
    "pdfkit": "^0.14.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@jest/globals": "^29.7.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.13.3",
    "@types/pngjs": "^6.0.5",
    "jest": "^29.7.0",
    "playwright": "1.56.1",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "optionalDependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
