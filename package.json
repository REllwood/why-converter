{
  "name": "why-converter",
  "version": "1.0.0",
  "description": "Why would you ever use this? A universal library for converting videos to PDF, GIF, or image sequences with advanced frame extraction options",
  "main": "./dist/node/index.node.js",
  "browser": "./dist/browser/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "require": "./dist/node/index.node.js",
        "import": "./dist/node/index.node.mjs"
      },
      "browser": "./dist/browser/index.js",
      "default": "./dist/node/index.node.js"
    }
  },
  "scripts": {
    "build": "npm run build:node && npm run build:browser && npm run build:types",
    "build:node": "tsc -p tsconfig.node.json",
    "build:browser": "webpack --config webpack.config.js",
    "build:types": "tsc -p tsconfig.node.json --declaration --emitDeclarationOnly --outDir dist/types && cp dist/types/index.node.d.ts dist/types/index.d.ts",
    "dev": "tsc -p tsconfig.node.json --watch",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "video",
    "pdf",
    "gif",
    "frames",
    "converter",
    "ffmpeg",
    "video-processing",
    "image-extraction",
    "why",
    "meme"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "fluent-ffmpeg": "^2.1.2",
    "gif.js": "^0.2.0",
    "gifenc": "^1.0.3",
    "jspdf": "^2.5.1",
    "pdfkit": "^0.14.0",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/fluent-ffmpeg": "^2.1.24",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.0",
    "@types/pdfkit": "^0.13.3",
    "@types/pngjs": "^6.0.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
